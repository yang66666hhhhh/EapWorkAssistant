<UserControl x:Class="EapWorkAssistant.Views.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
             xmlns:controls="clr-namespace:EapWorkAssistant.Controls"
             FontFamily="{StaticResource DefaultFont}">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClosePanelCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}"/>
    </UserControl.InputBindings>
    <Grid>
        <!-- 内层内容区域（带边距） -->
        <Grid Margin="{StaticResource PageMargin}">

        <!-- ===== 主区域 ===== -->
        <DockPanel>

            <!-- 顶部栏 -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="24,22"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,0,0,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="知识库" Style="{StaticResource Heading2}"/>
                            <Border  CornerRadius="{DynamicResource RadiusMd}" Padding="10,3"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource SectionPanel}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontWeight="Medium" VerticalAlignment="Center">
                                    <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                    <Run Text=" 条"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="构建您的 EAP、SECS/GEM、MES 知识库"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 收藏筛选 -->
                        <ToggleButton IsChecked="{Binding ShowFavoritesOnly}" Cursor="Hand"
                                      Style="{StaticResource BtnGhost}" Padding="10,6" Margin="0,0,8,0">
                            <ToggleButton.ToolTip>
                                <ToolTip Content="只看收藏"/>
                            </ToggleButton.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStar}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="收藏" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <!-- 分类筛选 -->
                        <ComboBox ItemsSource="{Binding FilterCategories}"
                                  SelectedItem="{Binding FilterCategory, Mode=TwoWay}"
                                  Style="{StaticResource Select}" Width="132" FontSize="12" Margin="0,0,10,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="">
                                                        <Setter Property="Text" Value="全部分类"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <controls:SearchBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                            Width="180" Placeholder="搜索知识…"/>
                        <Button Content="导出" Command="{Binding ExportJsonCommand}"
                                Style="{StaticResource BtnSecondary}" Margin="10,0,0,0" Padding="14,9" FontSize="12"/>
                        <Button Content="导入" Command="{Binding ImportJsonAsyncCommand}"
                                Style="{StaticResource BtnSecondary}" Margin="10,0,0,0" Padding="14,9" FontSize="12"/>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="16,0"/>
                        <controls:PrimaryActionButton x:Name="OpenFormBtn" Text="新增知识" Click="OpenForm_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 知识列表 -->
            <Border Style="{StaticResource Card}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0"
                    ClipToBounds="True">
                <DockPanel LastChildFill="True">
                    <controls:PaginationControl DockPanel.Dock="Bottom"
                                            CurrentPage="{Binding CurrentPage}"
                                            TotalPages="{Binding TotalPages}"
                                            TotalCount="{Binding TotalCount}"
                                            PageSize="{Binding PageSize, Mode=TwoWay}"
                                            PageSizeOptions="{Binding PageSizeOptions}"
                                            FirstPageCommand="{Binding FirstPageCommand}"
                                            PrevPageCommand="{Binding PrevPageCommand}"
                                            NextPageCommand="{Binding NextPageCommand}"
                                            LastPageCommand="{Binding LastPageCommand}"/>
                    <TextBlock DockPanel.Dock="Bottom" Margin="16,8,0,4"
                               Text="双击列表项可快速编辑 · 编辑中按 Ctrl+S 保存、Esc 关闭"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5"/>
                    <Grid>
                        <controls:DataGridBase x:Name="ItemsGrid" ItemsSource="{Binding PagedItems}" SelectedItem="{Binding SelectedItem}" TableKey="Knowledge"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanUserResizeColumns="True"
                                  ClipboardCopyMode="IncludeHeader"
                                  MouseDoubleClick="ItemsGrid_MouseDoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridColumnHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernGridCell}"/>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernGridRow}"/>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- 标题 -->
                                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="180" MinWidth="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding Title}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 内容摘要 -->
                                <DataGridTextColumn Header="内容摘要" Binding="{Binding Content}" Width="300" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding Content}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 分类 -->
                                <DataGridTemplateColumn Header="分类" Width="110" ClipboardContentBinding="{Binding Category}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:Badge Text="{Binding Category}"
                                                           BackgroundBrush="{DynamicResource SurfaceBrush}"
                                                           ForegroundBrush="{DynamicResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- 标签 -->
                                <DataGridTextColumn Header="标签" Binding="{Binding Tags}" Width="160" MinWidth="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding Tags}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 收藏 -->
                                <DataGridTemplateColumn Header="收藏" Width="64" ClipboardContentBinding="{Binding IsFavorite}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="{StaticResource IconStar}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource TextHintBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="1">
                                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- 创建时间 -->
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 操作：编辑 / 收藏切换 / 删除 -->
                                <DataGridTemplateColumn Header="操作" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Click="EditRow_Click"
                                                        Style="{StaticResource BtnGhost}" Padding="6,4" Margin="0,0,2,0"
                                                        ToolTip="编辑">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{DynamicResource TextSecondaryBrush}"
                                                          Data="{StaticResource IconPencil}"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnGhost}" Padding="6,4" Margin="2,0"
                                                        ToolTip="收藏 / 取消收藏">
                                                    <Path Width="14" Height="14" Stretch="Uniform">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Setter Property="Data" Value="{StaticResource IconStarOutline}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="1">
                                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                                        <Setter Property="Data" Value="{StaticResource IconStar}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnGhost}" Padding="6,4" Margin="2,0,0,0"
                                                        ToolTip="删除">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{DynamicResource DangerBrush}"
                                                          Data="{StaticResource IconTrash}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </controls:DataGridBase>

                        <!-- 空状态 -->
                        <Border Visibility="{Binding Items.Count, Converter={x:Static local:CountToVisibilityConverter.Instance}}"
                                Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Style="{StaticResource Card}">
                            <controls:EmptyState IconPathData="{StaticResource IconBook}"
                                                 Title="暂无知识条目"
                                                 Description="点击右上角「新增知识」按钮开始构建您的知识库"/>
                        </Border>

                        <!-- 搜索无结果：与通用空态区分 -->
                        <Border Visibility="{Binding IsSearchEmpty, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Style="{StaticResource Card}" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.25"/>
                                <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" FontWeight="Medium">
                                    <Run Text="未找到与 "/><Run Text="{Binding SearchKeyword}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" 相关的结果"/>
                                </TextBlock>
                                <TextBlock Text="换个关键词，或清空搜索重新浏览" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>
        </Grid>
        <!-- ===== 侧滑抽屉（封装遮罩 + 表单，内化动画/关闭逻辑） ===== -->
        <controls:Drawer x:Name="FormDrawer"
                         DrawerWidth="520"
                         HeaderIcon="{StaticResource IconBook}"
                         HeaderTitle="知识条目"
                         HeaderSubtitle="创建和管理您的专业知识文章"
                         SaveCommand="{Binding SaveCommand}"
                         Closing="FormDrawer_Closing"
                         Closed="FormDrawer_Closed">
            <controls:Drawer.FooterContent>
                <!-- ── 底部操作栏 ── -->
                <StackPanel Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" Opacity="0.5"/>

                    <!-- 操作按钮 -->
                    <Grid>
                        <Button Content="保存" Command="{Binding SaveCommand}"
                                Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                                Padding="32,10" FontSize="13">
                            <Button.ToolTip>
                                <ToolTip Content="保存 (Ctrl+S)"/>
                            </Button.ToolTip>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="新建" Command="{Binding NewCommand}"
                                    Style="{StaticResource BtnSecondary}" Padding="20,10">
                                <Button.Visibility>
                                    <Binding Path="CurrentItem.Id">
                                        <Binding.Converter>
                                            <local:IdToVisibilityConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                            <Button Content="删除" Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding SelectedItem}"
                                    Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                    Padding="20,10"/>
                        </StackPanel>
                    </Grid>

                    <!-- 状态消息 -->
                    <Border CornerRadius="{DynamicResource RadiusSm}" Padding="12,8" Margin="0,10,0,0"
                            Background="{DynamicResource SuccessLightBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Drawer.FooterContent>
            <controls:Drawer.Body>
                <!-- ── 表单字段区域（滚动） ── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource ModernScrollViewer}">
                    <StackPanel Margin="0,16,0,16">

                        <!-- ═══ 基本信息 ═══ -->
                        <Border  CornerRadius="{DynamicResource RadiusLg}"
                                Padding="18,16" Margin="0,0,0,16" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="基本信息" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>

                                <!-- 标题 -->
                                <TextBlock Text="标题" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CurrentItem.Title}"
                                         Style="{StaticResource Input}"
                                         Margin="0,0,0,16" TextChanged="FormField_Changed"/>

                                <!-- 分类（下拉建议） + 收藏 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="分类" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox SelectedItem="{Binding CurrentItem.Category, Mode=TwoWay}"
                                                  ItemsSource="{Binding AllCategories}"
                                                  IsEditable="False"
                                                  Style="{StaticResource Select}"
                                                  FontSize="13"
                                                  SelectionChanged="FormField_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                        <CheckBox IsChecked="{Binding CurrentItem.IsFavorite, Converter={x:Static local:BoolToIntConverter.Instance}}"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                                  Checked="FormField_Changed" Unchecked="FormField_Changed"
                                                  Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconStar}" Fill="{DynamicResource WarningBrush}"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="收藏" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 标签管理 ═══ -->
                        <Border  CornerRadius="{DynamicResource RadiusLg}"
                                Padding="18,16" Margin="0,0,0,16" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="标签管理" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>

                                <TextBox Text="{Binding CurrentItem.Tags}"
                                         Style="{StaticResource Input}"
                                         Margin="0,0,0,6" TextChanged="FormField_Changed"/>
                                <TextBlock Text="多个标签用逗号分隔，如：SECS/GEM, 通信协议"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,0,0,12"/>

                                <!-- 常用标签快捷添加 -->
                                <StackPanel>
                                    <TextBlock Text="常用标签" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,0,0,8" FontWeight="Medium"/>
                                    <ItemsControl ItemsSource="{Binding AllTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Style="{StaticResource BtnGhost}"
                                                        Padding="10,4" Margin="0,0,6,6" FontSize="11"
                                                        Click="TagSuggestion_Click" Cursor="Hand"
                                                        Foreground="{DynamicResource PrimaryBrush}" Opacity="0.7">
                                                    <Button.ToolTip>
                                                        <ToolTip Content="点击添加此标签"/>
                                                    </Button.ToolTip>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 知识内容 ═══ -->
                        <Border  CornerRadius="{DynamicResource RadiusLg}"
                                Padding="18,16" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="知识内容" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="支持多行文本编辑"
                                               FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox Text="{Binding CurrentItem.Content}"
                                         Height="260" Style="{StaticResource TextArea}"
                                         VerticalScrollBarVisibility="Auto" TextChanged="FormField_Changed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </controls:Drawer.Body>
        </controls:Drawer>

    </Grid>
</UserControl>
