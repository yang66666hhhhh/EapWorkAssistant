<Window x:Class="EapWorkAssistant.Views.ConfigItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <!-- 模态窗口：全屏遮罩 + 居中卡片 -->
    <Grid>
        <Border Background="{DynamicResource OverlayMaskBrush}"/>
        <Border Background="{DynamicResource CardBrush}" CornerRadius="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="400" Margin="32"
                Effect="{DynamicResource ModalHeavyShadow}">
            <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding WindowTitle}"
                       FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <TextBox Grid.Row="1" x:Name="InputTextBox"
                     Style="{StaticResource Input}"
                     Text="{Binding ItemValue, UpdateSourceTrigger=PropertyChanged}"
                     GotFocus="InputTextBox_GotFocus"
                     Margin="0,0,0,20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource BtnSecondary}"
                        Padding="16,9" Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Content="确认" Style="{StaticResource BtnPrimary}"
                        Padding="16,9"
                        Click="ConfirmButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
