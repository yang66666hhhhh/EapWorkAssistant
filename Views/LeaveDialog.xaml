<Window x:Class="EapWorkAssistant.Views.LeaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
        xmlns:views="clr-namespace:EapWorkAssistant.Views"
        Title="请假管理"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid>
        <!-- 模态遮罩（双主题，铺满全屏） -->
        <Border Background="{DynamicResource OverlayMaskBrush}"/>
        <!-- 对话框主卡片（重模态阴影，居中） -->
        <Border Style="{StaticResource Card}" Padding="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="500" Margin="32"
                Effect="{DynamicResource ModalHeavyShadow}">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="请假管理" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BtnGhost}" Padding="4" Click="CloseButton_Click"
                            ToolTip="关闭">
                        <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource TextTertiaryBrush}"/>
                    </Button>
                </Grid>

                <!-- 月份导航 -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}"
                        Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BtnGhost}" Padding="8,2"
                                Click="PrevMonth_Click" ToolTip="上个月">
                            <Path Data="{StaticResource IconChevronLeft}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                        <TextBlock x:Name="MonthLabel" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Padding="8,2"
                                Click="NextMonth_Click" ToolTip="下个月">
                            <Path Data="{StaticResource IconChevronRight}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 请假记录列表 -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}"
                        Padding="4" Margin="0,0,0,10" MinHeight="100">
                    <Grid>
                        <!-- 空状态提示 -->
                        <!-- 绑定 ListBox.HasItems 的反向可见性：有记录时隐藏，无记录时显示 -->
                        <TextBlock Text="本月暂无请假记录"
                                   FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding ElementName=LeaveList, Path=HasItems, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>

                        <ListBox x:Name="LeaveList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ModernListBoxItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="2,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 日期 -->
                                            <TextBlock Grid.Column="0" Text="{Binding Date}" FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <!-- 假期类型标签（彩色描边，按类型着色） -->
                                            <Border x:Name="TypeTag" Grid.Column="1"
                                                    CornerRadius="{DynamicResource RadiusXs}" Padding="8,2"
                                                    BorderThickness="1" VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock x:Name="TypeText" Text="{Binding LeaveType}" FontSize="11"
                                                           FontWeight="Medium"/>
                                            </Border>
                                            <!-- 工时 -->
                                            <TextBlock Grid.Column="2" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Run Text="{Binding Hours, Mode=OneWay, StringFormat={}{0}h}"/>
                                            </TextBlock>
                                            <!-- 操作按钮 -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnGhost}" Padding="4"
                                                        ToolTip="编辑" Click="EditLeave_Click"
                                                        Tag="{Binding}">
                                                    <Path Data="{StaticResource IconPencil}" Width="12" Height="12"
                                                          Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource BtnGhost}" Padding="4"
                                                        ToolTip="删除" Click="DeleteLeave_Click"
                                                        Tag="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Width="12" Height="12"
                                                          Stretch="Uniform" Fill="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding LeaveType}" Value="年假">
                                            <Setter TargetName="TypeTag" Property="BorderBrush" Value="{DynamicResource LeaveAnnualBrush}"/>
                                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource LeaveAnnualBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LeaveType}" Value="事假">
                                            <Setter TargetName="TypeTag" Property="BorderBrush" Value="{DynamicResource LeavePersonalBrush}"/>
                                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource LeavePersonalBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LeaveType}" Value="病假">
                                            <Setter TargetName="TypeTag" Property="BorderBrush" Value="{DynamicResource LeaveSickBrush}"/>
                                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource LeaveSickBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LeaveType}" Value="调休">
                                            <Setter TargetName="TypeTag" Property="BorderBrush" Value="{DynamicResource LeaveCompBrush}"/>
                                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource LeaveCompBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LeaveType}" Value="出差">
                                            <Setter TargetName="TypeTag" Property="BorderBrush" Value="{DynamicResource LeaveTravelBrush}"/>
                                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource LeaveTravelBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LeaveType}" Value="婚假">
                                            <Setter TargetName="TypeTag" Property="BorderBrush" Value="{DynamicResource LeaveMarriageBrush}"/>
                                            <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource LeaveMarriageBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 分隔线 -->
                <Separator Grid.Row="3" Style="{StaticResource Divider}" Margin="0,0,0,10"/>

                <!-- 新增/编辑表单 -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 日期 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="日期" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <Button Grid.Row="0" Grid.Column="1" x:Name="DateBtn"
                            Style="{StaticResource BtnSecondary}"
                            HorizontalContentAlignment="Left" Padding="10,7"
                            Margin="0,0,0,6" Click="DateBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCalendar}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="DateBtnText" Text="选择日期" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- 假期类型 -->
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="类型" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="LeaveTypeCombo" Grid.Row="0" Grid.Column="4"
                              Style="{StaticResource Select}" Margin="0,0,0,6"
                              ItemsSource="{Binding LeaveTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>

                    <!-- 工时 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="工时" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="HoursInput"
                                 Style="{StaticResource Input}" Text="8"
                                 PreviewTextInput="HoursInput_PreviewTextInput"/>
                        <TextBlock Grid.Column="1" Text="小时" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>

                    <!-- 备注 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="备注" Style="{StaticResource Label}"
                               VerticalAlignment="Top" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" x:Name="NoteInput"
                             Style="{StaticResource TextArea}" Height="48"
                             Margin="0,0,0,10"/>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelEditBtn" Content="取消编辑"
                                Style="{StaticResource BtnSecondary}"
                                Padding="14,8" Margin="0,0,8,0"
                                Click="CancelEdit_Click" Visibility="Collapsed"/>
                        <Button Content="添加记录" Style="{StaticResource BtnPrimary}"
                                Padding="14,8" Click="SaveLeave_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 日历浮窗覆盖层 -->
        <Border x:Name="CalendarBackdrop" Style="{StaticResource CalendarOverlay}"
                Panel.ZIndex="50" Margin="20" CornerRadius="{DynamicResource RadiusLg}"
                MouseLeftButtonDown="CalendarBackdrop_Click"/>
        <Border x:Name="CalendarContainer" Style="{StaticResource FloatingPanel}"
                Width="310" Panel.ZIndex="51"
                Visibility="Collapsed" Opacity="0">
            <views:CustomCalendar x:Name="SharedCal"/>
        </Border>
    </Grid>
</Window>
