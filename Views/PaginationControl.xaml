<UserControl x:Class="EapWorkAssistant.Views.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers">
    <UserControl.Resources>
        <!-- 分页控件内部专用页码按钮样式：高亮当前页，省略号禁用。
             注意：WPF 不允许在 Style 的 Trigger 中修改目标元素的 Style 属性，
             因此当前页高亮通过直接设置 Background/Foreground/FontWeight 实现。 -->
        <Style x:Key="PaginationPageNumberButton" TargetType="Button" BasedOn="{StaticResource PageNumberButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="{DynamicResource RadiusSm}" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="0">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Content" Value="..."/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding>
                            <MultiBinding.Converter>
                                <local:PageActiveConverter/>
                            </MultiBinding.Converter>
                            <Binding/>
                            <Binding Path="CurrentPage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="16,10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TotalCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：每页条数 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="每页" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding PageSizeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding PageSize, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Style="{StaticResource Select}" Width="68" FontSize="12"/>
                <TextBlock Text="条" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- 中间：翻页 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding FirstPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource PageNavButton}">
                    <Button.ToolTip><ToolTip Content="首页"/></Button.ToolTip>
                    <Path Data="{StaticResource IconSkipFirst}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Command="{Binding PrevPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource PageNavButton}" Margin="4,0,0,0">
                    <Button.ToolTip><ToolTip Content="上一页"/></Button.ToolTip>
                    <Path Data="{StaticResource IconChevronLeft}" Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>

                <!-- Simple 模式：当前页 / 总页数 -->
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Simple">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="第 "/><Run Text="{Binding CurrentPage, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Run Text=" / "/><Run Text="{Binding TotalPages, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text=" 页"/>
                </TextBlock>

                <!-- Numbered 模式：页码按钮 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Numbered">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,6" Opacity="0.5"/>
                    <ItemsControl ItemsSource="{Binding VisiblePageNumbers, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="1,0"
                                        Style="{StaticResource PaginationPageNumberButton}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,6" Opacity="0.5"/>
                </StackPanel>

                <Button Command="{Binding NextPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource PageNavButton}" Margin="4,0,0,0">
                    <Button.ToolTip><ToolTip Content="下一页"/></Button.ToolTip>
                    <Path Data="{StaticResource IconChevronRight}" Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Button Command="{Binding LastPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource PageNavButton}">
                    <Button.ToolTip><ToolTip Content="末页"/></Button.ToolTip>
                    <Path Data="{StaticResource IconSkipLast}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- 右侧：总条数 -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}">
                <Run Text="共 "/><Run Text="{Binding TotalCount, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                    FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/><Run Text=" 条"/>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
