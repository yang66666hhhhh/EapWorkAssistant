<UserControl x:Class="EapWorkAssistant.Views.WorkRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
             xmlns:controls="clr-namespace:EapWorkAssistant.Controls"
             FontFamily="{StaticResource DefaultFont}">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveRecordCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ClosePanelCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewRecordCommand}"/>
    </UserControl.InputBindings>
    <Grid>
        <!-- 内层内容区域 -->
        <Grid Margin="{StaticResource PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Tab 切换栏 ===== -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="当日记录" Click="TabDaily_Click"
                        Style="{StaticResource TabDailyButton}"/>
                <Button Content="全部记录" Click="TabAll_Click" Margin="6,0,0,0"
                        Style="{StaticResource TabAllButton}"/>
            </StackPanel>

            <!-- ===== Tab 0: 当日记录 ===== -->
            <Border Grid.Row="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 顶部栏 ===== -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,0,0,14" ClipToBounds="True">
                <StackPanel>
                    <!-- 标题行 -->
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="工作记录" Style="{StaticResource Heading2}"/>
                                <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="{DynamicResource RadiusSm}"
                                        Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="今日 " FontSize="11" Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecordCount}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" 条" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="双击条目可快速编辑 · 编辑中按 Ctrl+S 保存、Esc 关闭"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                        <controls:PrimaryActionButton x:Name="OpenFormBtn" Text="新增记录" Click="OpenForm_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                        <!-- 工具栏 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- 日期显示 -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="10,0" Height="34" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCalendar}" Fill="{DynamicResource TextSecondaryBrush}"
                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" Opacity="0.7"/>
                                        <TextBlock x:Name="DateDisplayText" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="CalendarToggleBtn" Content="选择日期" Click="CalendarToggle_Click"
                                        Style="{StaticResource BtnSecondary}" Margin="6,0,0,0" Padding="10,7" FontSize="12"/>

                                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,5" Opacity="0.5"/>

                                <!-- 报告按钮组 -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="日报" Command="{Binding GenerateDailyReportCommand}"
                                            Style="{StaticResource BtnPrimary}" Padding="10,7" FontSize="12"/>
                                    <Button Content="周报" Command="{Binding GenerateWeeklyReportCommand}"
                                            Style="{StaticResource BtnSuccess}" Margin="5,0,0,0" Padding="10,7" FontSize="12"/>
                                    <Button Content="月报" Command="{Binding GenerateMonthlyReportCommand}"
                                            Style="{StaticResource BtnWarning}" Margin="5,0,0,0" Padding="10,7" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 请假按钮（右对齐） -->
                            <Button Grid.Column="2" Command="{Binding ShowLeaveFormCommand}"
                                    Style="{StaticResource BtnGhost}" Padding="10,7" FontSize="12"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    ToolTip="为当天添加请假记录">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCalendar}" Fill="{DynamicResource PrimaryBrush}"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="+ 请假" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
            </Border>

            <!-- ===== 数据统计条（带左侧色带） ===== -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:StatCard Grid.Column="0" Title="今日工时"
                                Value="{Binding TodayHours, StringFormat={}{0:F1}}" Unit="h"
                                BarBrush="{DynamicResource PrimaryBrush}"
                                IconBackgroundBrush="{DynamicResource PrimaryLightBrush}"
                                IconForegroundBrush="{DynamicResource PrimaryBrush}"
                                IconPathData="{StaticResource IconClock}"
                                CardStyle="{StaticResource Card}"
                                IsCompact="True"/>

                <controls:StatCard Grid.Column="2" Title="记录数"
                                Value="{Binding RecordCount}" Unit="条"
                                BarBrush="{DynamicResource SuccessBrush}"
                                IconBackgroundBrush="{DynamicResource SuccessLightBrush}"
                                IconForegroundBrush="{DynamicResource SuccessBrush}"
                                IconPathData="{StaticResource IconList}"
                                CardStyle="{StaticResource Card}"
                                IsCompact="True"/>

                <controls:StatCard Grid.Column="4" Title="亮点标记"
                                Value="{Binding HighlightCount}" Unit="项"
                                BarBrush="{DynamicResource WarningBrush}"
                                IconBackgroundBrush="{DynamicResource WarningLightBrush}"
                                IconForegroundBrush="{DynamicResource WarningBrush}"
                                IconPathData="{StaticResource IconStar}"
                                CardStyle="{StaticResource Card}"
                                IsCompact="True"/>

                <controls:StatCard Grid.Column="6" Title="调休余额"
                                Value="{Binding CompLeaveAvailable, StringFormat={}{0:F1}}" Unit="h"
                                BarBrush="{DynamicResource InfoBrush}"
                                IconBackgroundBrush="{DynamicResource InfoLightBrush}"
                                IconForegroundBrush="{DynamicResource InfoBrush}"
                                IconPathData="{StaticResource IconRefresh}"
                                CardStyle="{StaticResource Card}"
                                IsCompact="True">
                    <controls:StatCard.SubText>
                        <MultiBinding StringFormat="加班 {0:F1}h · 已休 {1:F1}h">
                            <Binding Path="OvertimeHours"/>
                            <Binding Path="CompLeaveUsed"/>
                        </MultiBinding>
                    </controls:StatCard.SubText>
                </controls:StatCard>
            </Grid>

            <!-- ===== 请假记录列表 ===== -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <!-- 当日请假记录列表 -->
                <ItemsControl ItemsSource="{Binding DailyLeaveRecords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusSm}"
                                    Padding="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 彩色左边框 -->
                                    <Border x:Name="LeaveBar" Grid.Column="0" CornerRadius="{DynamicResource RadiusLeftSm}"
                                            Background="{DynamicResource TextTertiaryBrush}"/>
                                    <Grid Grid.Column="1" Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 类型标签 -->
                                        <Border x:Name="LeaveTag" Grid.Column="0" CornerRadius="{DynamicResource RadiusXs}"
                                                Padding="8,2" BorderThickness="1" VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                            <TextBlock x:Name="LeaveTagText" Text="{Binding LeaveType}" FontSize="11"
                                                       FontWeight="Medium"/>
                                        </Border>
                                        <!-- 工时 -->
                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Run Text="{Binding Hours, Mode=OneWay, StringFormat={}{0}h}"/>
                                        </TextBlock>
                                        <!-- 备注 -->
                                        <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Note}"/>
                                    </Grid>
                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <Button Style="{StaticResource BtnGhost}" Padding="4"
                                                ToolTip="编辑" Command="{Binding DataContext.EditLeaveRecordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconPencil}" Width="12" Height="12"
                                                  Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource BtnGhost}" Padding="4"
                                                ToolTip="删除" Command="{Binding DataContext.DeleteLeaveRecordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Width="12" Height="12"
                                                  Stretch="Uniform" Fill="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding LeaveType}" Value="年假">
                                    <Setter TargetName="LeaveBar" Property="Background" Value="{DynamicResource LeaveAnnualBrush}"/>
                                    <Setter TargetName="LeaveTag" Property="BorderBrush" Value="{DynamicResource LeaveAnnualBrush}"/>
                                    <Setter TargetName="LeaveTagText" Property="Foreground" Value="{DynamicResource LeaveAnnualBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LeaveType}" Value="事假">
                                    <Setter TargetName="LeaveBar" Property="Background" Value="{DynamicResource LeavePersonalBrush}"/>
                                    <Setter TargetName="LeaveTag" Property="BorderBrush" Value="{DynamicResource LeavePersonalBrush}"/>
                                    <Setter TargetName="LeaveTagText" Property="Foreground" Value="{DynamicResource LeavePersonalBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LeaveType}" Value="病假">
                                    <Setter TargetName="LeaveBar" Property="Background" Value="{DynamicResource LeaveSickBrush}"/>
                                    <Setter TargetName="LeaveTag" Property="BorderBrush" Value="{DynamicResource LeaveSickBrush}"/>
                                    <Setter TargetName="LeaveTagText" Property="Foreground" Value="{DynamicResource LeaveSickBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LeaveType}" Value="调休">
                                    <Setter TargetName="LeaveBar" Property="Background" Value="{DynamicResource LeaveCompBrush}"/>
                                    <Setter TargetName="LeaveTag" Property="BorderBrush" Value="{DynamicResource LeaveCompBrush}"/>
                                    <Setter TargetName="LeaveTagText" Property="Foreground" Value="{DynamicResource LeaveCompBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LeaveType}" Value="出差">
                                    <Setter TargetName="LeaveBar" Property="Background" Value="{DynamicResource LeaveTravelBrush}"/>
                                    <Setter TargetName="LeaveTag" Property="BorderBrush" Value="{DynamicResource LeaveTravelBrush}"/>
                                    <Setter TargetName="LeaveTagText" Property="Foreground" Value="{DynamicResource LeaveTravelBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LeaveType}" Value="婚假">
                                    <Setter TargetName="LeaveBar" Property="Background" Value="{DynamicResource LeaveMarriageBrush}"/>
                                    <Setter TargetName="LeaveTag" Property="BorderBrush" Value="{DynamicResource LeaveMarriageBrush}"/>
                                    <Setter TargetName="LeaveTagText" Property="Foreground" Value="{DynamicResource LeaveMarriageBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 数据表格 + 报告预览 ===== -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- 表格 -->
                <Border Grid.Row="0" Style="{StaticResource Card}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0"
                        ClipToBounds="True">
                    <Grid>
                    <controls:DataGridBase ItemsSource="{Binding Records}" TableKey="WorkRecord"
                              SelectedItem="{Binding SelectedDailyRecord, Mode=TwoWay}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              ClipboardCopyMode="IncludeHeader"
                              MouseDoubleClick="RecordsGrid_MouseDoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridColumnHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernGridCell}"/>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernGridRow}"/>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="38"
                                                        CellTemplate="{StaticResource HighlightStarCell}">
                                    <DataGridTemplateColumn.Header>
                                        <Path Data="{StaticResource IconStar}" Fill="{DynamicResource WarningBrush}"
                                              Width="13" Height="13" Stretch="Uniform"/>
                                    </DataGridTemplateColumn.Header>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="任务" Binding="{Binding ProjectName}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding ProjectName}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 类型 - 彩色标签 -->
                                <DataGridTemplateColumn Header="类型" Width="100"
                                                        ClipboardContentBinding="{Binding WorkType}"
                                                        CellTemplate="{StaticResource WorkTypeBadgeCell}"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="300" MinWidth="240">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding Content}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="工作成果" Binding="{Binding Achievement}" Width="240" MinWidth="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding Achievement}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="工时" Binding="{Binding Hours, StringFormat={}{0:F1}h}" Width="80"/>
                                <!-- 进度 - 进度条 -->
                                <DataGridTemplateColumn Header="进度" Width="144"
                                                        ClipboardContentBinding="{Binding Progress, StringFormat={}{0}%}"
                                                        CellTemplate="{StaticResource ProgressBarCell}"/>
                                <DataGridTextColumn Header="问题描述" Binding="{Binding Problem}" Width="240" MinWidth="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding Problem}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="解决方案" Binding="{Binding Solution}" Width="240" MinWidth="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                            <Setter Property="ToolTip" Value="{Binding Solution}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="操作" Width="136">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="编辑"
                                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Click="EditRow_Click"
                                                        Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="12"/>
                                                <Button Content="删除"
                                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="12"
                                                        Foreground="{DynamicResource DangerBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </controls:DataGridBase>

                        <!-- 空状态 -->
                        <Border Visibility="{Binding Records.Count, Converter={x:Static local:CountToVisibilityConverter.Instance}}"
                                Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Style="{StaticResource Card}">
                            <controls:EmptyState IconPathData="{StaticResource IconPencil}"
                                                 Title="当日暂无工作记录"
                                                 Description="点击上方按钮开始记录"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 拖拽分隔条 -->
                <GridSplitter Grid.Row="1" Style="{StaticResource DragSplitter}"/>

                <!-- 报告预览 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,8">
                            <Path Data="{StaticResource IconTrend}" Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" Opacity="0.7"/>
                            <TextBlock Text="报告预览" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="10,0" Opacity="0.5"/>
                            <Button Content="复制" Command="{Binding CopyReportCommand}"
                                    Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11.5"
                                    Foreground="{DynamicResource SuccessBrush}"/>
                            <Button Content="保存" Command="{Binding SaveReportCommand}"
                                    Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11.5"
                                    Foreground="{DynamicResource WarningBrush}"/>
                            <Button Content="Markdown" Command="{Binding SaveReportAsMarkdownCommand}"
                                    Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11.5"
                                    Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusMd}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Margin="10,0,10,10" Padding="12">
                            <controls:MarkdownViewer x:Name="ReportViewer" MarkdownText="{Binding ReportText}"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>
            </Border>

            <!-- ===== Tab 1: 全部记录 ===== -->
            <Border Grid.Row="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 筛选栏 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}"
                            Margin="0,0,0,10" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource PrimaryGradient}" CornerRadius="{DynamicResource RadiusLeftCard}"/>
                            <StackPanel Grid.Column="1" Margin="18,12,18,12">
                                <!-- 标题行 -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="全部记录" Style="{StaticResource Heading2}"/>
                                        <TextBlock Text="查看和筛选所有工作记录"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- CSV 导入导出按钮组：全部记录页同步支持导入 -->
                                        <Button Content="导入CSV" Command="{Binding ImportCsvCommand}"
                                                Style="{StaticResource BtnGhost}" Padding="10,7" FontSize="12"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Background="{DynamicResource PrimarySoftBrush}"
                                                ToolTip="从 CSV 文件批量导入工作记录"/>
                                        <Button Content="导出CSV" Command="{Binding ExportAllCsvCommand}"
                                                Style="{StaticResource BtnGhost}" Padding="10,7" FontSize="12"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10" Opacity="0.7"/>
                                <!-- 筛选条件 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 日期快捷 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="本周" Command="{Binding SetDatePresetCommand}" CommandParameter="thisWeek"
                                                Style="{StaticResource DatePresetThisWeek}" Margin="0,0,5,0"/>
                                        <Button Content="本月" Command="{Binding SetDatePresetCommand}" CommandParameter="thisMonth"
                                                Style="{StaticResource DatePresetThisMonth}" Margin="0,0,5,0"/>
                                        <Button Content="近3月" Command="{Binding SetDatePresetCommand}" CommandParameter="last3Months"
                                                Style="{StaticResource DatePresetLast3Months}" Margin="0,0,5,0"/>
                                        <Button Content="全部" Command="{Binding SetDatePresetCommand}" CommandParameter="all"
                                                Style="{StaticResource DatePresetAllButton}"/>
                                    </StackPanel>
                                    <!-- 开始日期 -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="从" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button x:Name="FilterStartBtn" Click="FilterStart_Click"
                                                Style="{StaticResource BtnSecondary}" Padding="10,6" FontSize="12">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCalendar}" Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
                                                <TextBlock x:Name="FilterStartText" Text="开始日期" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <!-- 结束日期 -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="至" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button x:Name="FilterEndBtn" Click="FilterEnd_Click"
                                                Style="{StaticResource BtnSecondary}" Padding="10,6" FontSize="12">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCalendar}" Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
                                                <TextBlock x:Name="FilterEndText" Text="结束日期" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
