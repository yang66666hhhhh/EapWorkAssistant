                                                            CommandParameter="{Binding}"
                                                            Click="EditRow_Click"
                                                            Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="12"/>
                                                    <Button Content="删除"
                                                            Command="{Binding DataContext.DeleteAllRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="12"
                                                            Foreground="{DynamicResource DangerBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </controls:DataGridBase>
                            <!-- 空状态 -->
                            <Border Visibility="{Binding AllRecords.Count, Converter={x:Static local:CountToVisibilityConverter.Instance}}"
                                    Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Style="{StaticResource Card}">
                                <controls:EmptyState IconPathData="{StaticResource IconSearch}"
                                                     Title="暂无匹配的工作记录"
                                                     Description="尝试调整筛选条件"/>
                            </Border>

                            <!-- 搜索无结果：与通用空态区分 -->
                            <Border Visibility="{Binding IsSearchEmpty, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                    Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Style="{StaticResource Card}" IsHitTestVisible="False">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextPrimaryBrush}"
                                          Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.25"/>
                                    <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" FontWeight="Medium">
                                        <Run Text="未找到与 "/><Run Text="{Binding SearchKeyword}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" 相关的工作记录"/>
                                    </TextBlock>
                                    <TextBlock Text="换个关键词，或清空搜索重新浏览" FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 共享日历浮窗（当日记录 + 全部记录筛选共用） ===== -->
        <Border x:Name="CalendarBackdrop" Style="{StaticResource CalendarOverlay}"
                MouseLeftButtonDown="CalendarBackdrop_Click"
                Panel.ZIndex="50"/>
        <Border x:Name="CalendarContainer" Style="{StaticResource FloatingPanel}"
                Margin="20,90,0,0" Panel.ZIndex="51"
                Width="310">
            <controls:CustomCalendar x:Name="SharedCal"
                                  SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>
        </Border>

        <!-- ===== 侧滑抽屉（封装遮罩 + 表单，内化动画/关闭逻辑） ===== -->
        <controls:Drawer x:Name="FormDrawer"
                         DrawerWidth="520"
                         SaveCommand="{Binding SaveRecordCommand}"
                         Closing="FormDrawer_Closing"
                         Closed="FormDrawer_Closed">
            <controls:Drawer.HeaderContent>
<StackPanel Margin="0,0,0,4">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource PrimaryLightBrush}"
                                    CornerRadius="{DynamicResource RadiusSm}" Width="32" Height="32" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconClipboard}" Fill="{DynamicResource PrimaryBrush}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormTitle}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedDate, StringFormat='yyyy-MM-dd ddd'}" FontSize="11.5"
                                               Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,2,8,2"/>
                                    <TextBlock Text="记录每日工作内容与成果" FontSize="11.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnGhost}" Padding="8,6">
                                <Button.ToolTip>
                                    <ToolTip Content="使用模板填充内容"/>
                                </Button.ToolTip>
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconList}" Fill="{DynamicResource PrimaryBrush}"
                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="模板" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Button Click="CopyLast_Click"
                                    Style="{StaticResource BtnGhost}" Padding="8,6">
                                <Button.ToolTip>
                                    <ToolTip Content="复制上一条记录的任务和类型"/>
                                </Button.ToolTip>
                                <TextBlock Text="复制上条" FontSize="12"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>
                            <Button Command="{Binding CloseCommand, ElementName=FormDrawer}"
                                    Style="{StaticResource BtnGhost}" Padding="8,6" Margin="4,0,0,0">
                                <Button.ToolTip>
                                    <ToolTip Content="关闭面板 (Esc)"/>
                                </Button.ToolTip>
                                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,0" Opacity="0.5"/>
                </StackPanel>
            </controls:Drawer.HeaderContent>
            <controls:Drawer.FooterContent>
<StackPanel Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" Opacity="0.5"/>

                    <!-- 操作按钮 -->
                    <Grid>
                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveRecordCommand}"
                                Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                                Padding="32,10" FontSize="13">
                            <Button.ToolTip>
                                <ToolTip Content="保存 (Ctrl+S)"/>
                            </Button.ToolTip>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="删除" Command="{Binding DeleteCurrentRecordCommand}"
                                    Style="{StaticResource BtnGhost}" Padding="16,10" FontSize="12"
                                    Foreground="{DynamicResource DangerBrush}">
                                <Button.Visibility>
                                    <Binding Path="CurrentRecord.Id">
                                        <Binding.Converter>
                                            <local:IdToVisibilityConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                            <Button Content="新建" Command="{Binding NewRecordCommand}"
                                    Style="{StaticResource BtnSecondary}" Padding="20,10"
                                    Margin="8,0,0,0">
                                <Button.Visibility>
                                    <Binding Path="CurrentRecord.Id">
                                        <Binding.Converter>
                                            <local:IdToVisibilityConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 状态消息 -->
                    <Border CornerRadius="{DynamicResource RadiusSm}" Padding="12,8" Margin="0,10,0,0"
                            Background="{DynamicResource SuccessLightBrush}"
                            Visibility="{Binding StatusMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Drawer.FooterContent>
            <controls:Drawer.Body>
<ScrollViewer VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource ModernScrollViewer}">
                    <StackPanel Margin="0,16,0,16">

                        <!-- ═══ 基本信息 ═══ -->
                        <Border  CornerRadius="{DynamicResource RadiusLg}"
                                Padding="18,16" Margin="0,0,0,16" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="基本信息" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>

                                <!-- 任务 + 类型 -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="任务" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Projects}" SelectedValue="{Binding CurrentRecord.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource Select}" SelectionChanged="FormField_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="类型" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding WorkTypes}" SelectedValue="{Binding CurrentRecord.WorkType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource Select}" SelectionChanged="FormField_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 快捷模板 -->
                                <TextBlock Text="快捷模板" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding ContentTemplates}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" Style="{StaticResource BtnGhost}"
                                                    Padding="10,5" Margin="0,0,6,6" FontSize="12"
                                                    Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{DynamicResource PrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 工作记录 ═══ -->
                        <Border  CornerRadius="{DynamicResource RadiusLg}"
                                Padding="18,16" Margin="0,0,0,16" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="工作记录" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>

                                <!-- 工作内容 -->
                                <TextBlock Text="工作内容" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CurrentRecord.Content}" Height="160"
                                         Style="{StaticResource TextArea}" Margin="0,0,0,6"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextChanged="FormField_Changed"/>
                                <TextBlock Text="描述做了什么、关键产出和交付物" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,16"/>

                                <!-- 工作成果 -->
                                <TextBlock Text="工作成果" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CurrentRecord.Achievement}" Height="140"
                                         Style="{StaticResource TextArea}" Margin="0,0,0,6"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextChanged="FormField_Changed"/>
                                <TextBlock Text="记录本项工作的具体成果和产出（可选，用于转正述职报告）" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 其他信息 ═══ -->
                        <Border  CornerRadius="{DynamicResource RadiusLg}"
                                Padding="18,16" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="其他信息" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>

                                <!-- 问题与解决方案 -->
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusMd}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="14,10" Margin="0,0,0,14" Cursor="Hand">
                                    <StackPanel>
                                        <CheckBox Content="遇到了问题？点击展开记录"
                                                  IsChecked="{Binding HasProblem, Mode=TwoWay}"
                                                  FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Visibility="{Binding HasProblem, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                                    Margin="0,10,0,4">
                                            <TextBlock Text="问题描述" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding CurrentRecord.Problem}" Height="110"
                                                     Style="{StaticResource TextArea}" Margin="0,0,0,10"
                                                     VerticalScrollBarVisibility="Auto" TextChanged="FormField_Changed"/>
                                            <TextBlock Text="解决方案" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding CurrentRecord.Solution}" Height="110"
                                                     Style="{StaticResource TextArea}" Margin="0,0,0,4"
                                                     VerticalScrollBarVisibility="Auto" TextChanged="FormField_Changed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 工时与进度 -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="{DynamicResource RadiusMd}" Padding="14,10"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="工时 (小时)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CurrentRecord.Hours}" Style="{StaticResource Input}"
                                                     BorderThickness="0" Background="Transparent" Padding="0,4"
                                                     PreviewTextInput="HoursInput_PreviewTextInput"
                                                     TextChanged="FormField_Changed"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="{DynamicResource RadiusMd}" Padding="14,10"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="进度 (%)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CurrentRecord.Progress}" Style="{StaticResource Input}"
                                                     BorderThickness="0" Background="Transparent" Padding="0,4"
                                                     PreviewTextInput="ProgressInput_PreviewTextInput"
                                                     TextChanged="FormField_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 亮点标记 -->
                                <Border Background="{DynamicResource WarningLightBrush}" CornerRadius="{DynamicResource RadiusMd}"
                                        Padding="14,12" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <CheckBox
                                                  IsChecked="{Binding CurrentRecord.IsHighlight, Converter={x:Static local:BoolToIntConverter.Instance}}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Margin="0,0,0,8" Cursor="Hand" FontSize="13" FontWeight="SemiBold"
                                                  Checked="FormField_Changed" Unchecked="FormField_Changed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconStar}" Fill="{DynamicResource WarningBrush}"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="标记为工作亮点" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel >
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentRecord.IsHighlight}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBox Text="{Binding CurrentRecord.HighlightNote, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextArea}" Height="72"
                                                     VerticalScrollBarVisibility="Auto"/>
                                            <TextBlock Text="简要描述这项工作的亮点和成果" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </controls:Drawer.Body>
        </controls:Drawer>

    </Grid>
</UserControl>
