<Window x:Class="EapWorkAssistant.Views.ImportCsvDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入工作记录"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <!-- 模态窗口：全屏遮罩 + 居中卡片 -->
    <Grid>
        <Border Background="{DynamicResource OverlayMaskBrush}"/>
        <Border Style="{StaticResource Card}" Padding="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="480" Margin="32"
                Effect="{DynamicResource ModalHeavyShadow}">
            <Grid Margin="28,22,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource PrimaryLightBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource PrimaryBrush}"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="导入工作记录" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 解析概览 -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="20"/>
                    <TextBlock x:Name="SkippedText" Margin="0,6,0,0" FontSize="12" Opacity="0.85"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                    <TextBlock x:Name="ConfigWarningText" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>

                <!-- 模式选择 -->
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <TextBlock Text="导入模式" Style="{StaticResource Label}" Margin="0,0,0,8"/>

                    <!-- 跳过重复（推荐） -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton x:Name="SkipRadio" GroupName="ImportMode" IsChecked="True"
                                         Style="{StaticResource ToggleChip}" Tag="SkipDuplicate"
                                         Checked="Mode_Checked" Content="跳过重复（推荐）"/>
                            <TextBlock Text="库中已存在则保留不动，只新增全新记录。适合导出备份后恢复/迁移。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,4"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryBrush}">
                                <Run Text="将新增 "/><Run Text="{Binding SkipPreview.Insert}"/><Run Text=" 条，跳过重复 "/><Run Text="{Binding SkipPreview.Skip}"/><Run Text=" 条"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 覆盖更新 -->
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <RadioButton x:Name="OverwriteRadio" GroupName="ImportMode"
                                         Style="{StaticResource ToggleChip}" Tag="Overwrite"
                                         Checked="Mode_Checked" Content="覆盖更新"/>
                            <TextBlock Text="以 CSV 为准，全量替换匹配到的记录（保留 Id 与创建时间）。适合修改 CSV 后导回。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,4"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource WarningBrush}">
                                <Run Text="将新增 "/><Run Text="{Binding OverwritePreview.Insert}"/><Run Text=" 条，覆盖 "/><Run Text="{Binding OverwritePreview.Update}"/><Run Text=" 条"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 全部新增 -->
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <RadioButton x:Name="AppendRadio" GroupName="ImportMode"
                                         Style="{StaticResource ToggleChip}" Tag="Append"
                                         Checked="Mode_Checked" Content="全部新增"/>
                            <TextBlock Text="忽略重复，强制追加为新条目。适合明确要补一批新数据。"
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,4"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="将新增 "/><Run Text="{Binding AppendPreview.Insert}"/><Run Text=" 条（含重复）"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 按钮 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource BtnSecondary}"
                            Padding="18,9" Margin="0,0,10,0" IsCancel="True"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}" Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton" Content="开始导入" Style="{StaticResource BtnPrimary}"
                            Padding="18,9" IsDefault="True"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}" Click="ConfirmButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
