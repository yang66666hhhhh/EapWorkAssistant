<Window x:Class="EapWorkAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
        xmlns:vm="clr-namespace:EapWorkAssistant.ViewModels"
        xmlns:views="clr-namespace:EapWorkAssistant.Views"
        xmlns:svc="clr-namespace:EapWorkAssistant.Services"
        Title="EAP Work Assistant" Height="800" Width="1320"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource DefaultFont}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        ToolTipService.InitialShowDelay="150"
        ToolTipService.BetweenShowDelay="50">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 侧边栏宽度：展开 240（建议范围 220–280）、折叠 72（图标轨道）-->
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 侧边栏（适配亮/暗色主题） ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" Direction="90"/>
            </Border.Effect>
            <DockPanel>
                <!-- Logo（展开态：图标 + 文字并排；折叠态：仅图标居中） -->
                <Grid x:Name="HeaderExpanded" DockPanel.Dock="Top" Margin="24,28,16,28"
                      Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{DynamicResource PrimaryGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25"/>
                        </Border.Effect>
                        <TextBlock Text="EAP" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                        <TextBlock Text="EAP Work" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource DefaultFont}"/>
                        <TextBlock Text="Assistant v2.1" FontSize="11"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SidebarToggleButton}"
                            Click="SidebarToggle_Click" VerticalAlignment="Top"/>
                </Grid>

                <!-- 折叠态头部：图标 + 切换按钮均居中 -->
                <StackPanel x:Name="HeaderCollapsed" DockPanel.Dock="Top"
                            Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                            Margin="0,28,0,16">
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{DynamicResource PrimaryGradient}" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25"/>
                        </Border.Effect>
                        <TextBlock Text="EAP" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}"/>
                    </Border>
                    <Button Style="{StaticResource SidebarToggleButton}"
                            Click="SidebarToggle_Click" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- 底部个人卡片（头像独立 + 装饰环收缩动画） -->
                <Grid x:Name="ProfileArea" DockPanel.Dock="Bottom" Margin="16,0,16,20" MinHeight="0">

                    <!-- 装饰环/灰色卡片背景（收缩目标：以头像中心为原点缩至 0 并淡出） -->
                    <Border x:Name="ProfileCardRing" CornerRadius="12" Padding="16"
                            Cursor="Hand" MouseLeftButtonDown="ProfileCard_Click"
                            Background="{DynamicResource SidebarCardBgBrush}"
                            RenderTransformOrigin="0.15,0.28">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProfileRingScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel x:Name="ProfileCardContent">
                            <Grid Margin="0,0,0,10">
                                <!-- 头像占位（保持文字布局空间不变） -->
                                <Border Width="34" Height="34" CornerRadius="17"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Hidden"/>
                                <StackPanel x:Name="ProfileInfo" Margin="44,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static svc:ProfileService.Instance}, Path=Name}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Source={x:Static svc:ProfileService.Instance}, Path=Role}"
                                               FontSize="11" Foreground="{DynamicResource SidebarTextBrush}"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="ProfileMeta" Background="{DynamicResource SidebarCardBgBrush}" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static svc:ProfileService.Instance}, Path=Industry}"
                                               FontSize="11" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock Text="{Binding Source={x:Static svc:ProfileService.Instance}, Path=Department}"
                                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 头像（独立层，z-index 更高，不参与收缩动画，始终完整显示）
                         展开态：左对齐（与卡片内 padding 对齐）；折叠态：居中（与导航图标中心轴对齐）
                         头像本身承载点击/悬浮交互，独立于装饰环，折叠后仍可点击打开个人信息 -->
                    <Border x:Name="AvatarBorder" Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource PrimaryGradient}"
                            Cursor="Hand" MouseLeftButtonDown="ProfileCard_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="Margin" Value="16,16,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,16,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ToolTip>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static svc:ProfileService.Instance}, Path=Name}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Source={x:Static svc:ProfileService.Instance}, Path=Role}"
                                           FontSize="11" Foreground="{DynamicResource SidebarTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border.ToolTip>
                        <Grid>
                            <TextBlock Text="{Binding Source={x:Static svc:ProfileService.Instance}, Path=AvatarInitial}"
                                       FontSize="15" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- 头像图片层 -->
                            <Border CornerRadius="17"
                                    Visibility="{Binding Source={x:Static svc:ProfileService.Instance}, Path=HasAvatar, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding Source={x:Static svc:ProfileService.Instance}, Path=AvatarPath, Converter={x:Static local:AvatarPathConverter.Instance}}"/>
                                </Border.Background>
                            </Border>
                            <!-- 悬浮编辑提示 -->
                            <Border x:Name="SidebarAvatarOverlay" CornerRadius="17"
                                    Background="{DynamicResource AvatarOverlayBrush}" Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Path Data="{StaticResource IconPencil}" Fill="White"
                                      Width="12" Height="12" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 分隔线 -->
                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource SidebarTextBrush}" Opacity="0.2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Margin" Value="24,0,24,16"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Margin" Value="12,0,12,10"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- 导航 -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="主菜单"/>
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding SelectedIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}"
                                     Content="工作台" Tag="{StaticResource IconChart}"/>
                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="工作"/>
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding SelectedIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}"
                                     Content="工作记录" Tag="{StaticResource IconPencil}"/>
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding SelectedIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=2}"
                                     Content="知识库" Tag="{StaticResource IconBook}"/>
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding SelectedIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=3}"
                                     Content="问题跟踪" Tag="{StaticResource IconWrench}"/>
                        <TextBlock Style="{StaticResource SidebarSectionHeader}" Text="系统"/>
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding SelectedIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=4}"
                                     Content="设置" Tag="{StaticResource IconGear}"/>
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding SelectedIndex, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=5}"
                                     Content="回收站" Tag="{StaticResource IconTrash}"
                                     local:NavButtonProperties.Badge="{Binding RecycleBin.TotalCount}">
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== 主内容区 ===== -->
        <Grid Grid.Column="1" x:Name="MainContentArea">

            <!-- 子视图内容（全区域，不占位） -->
            <Border Background="{DynamicResource SurfaceBrush}">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:WorkRecordViewModel}">
                            <views:WorkRecordView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:KnowledgeViewModel}">
                            <views:KnowledgeView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                            <views:IssueView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                            <views:SettingsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:RecycleBinViewModel}">
                            <views:RecycleBinView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>

            <!-- ===== Spotlight 风格居中搜索 ===== -->
            <!-- 注意：此处使用 MVVM DataTrigger + Storyboard 动画而非标准 OverlayBackdrop 样式，
                 因为 Spotlight 搜索需要 opacity 渐变 + 居中弹出效果，与表单抽屉/日历浮窗的 Visibility 切换机制不同 -->
            <!-- 全屏遮罩 -->
            <Border Panel.ZIndex="50" x:Name="SearchOverlayBorder"
                    Background="{DynamicResource OverlayMaskBrush}" MouseLeftButtonDown="SearchOverlay_Click"
                    Opacity="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- 居中搜索面板 -->
            <Border Panel.ZIndex="60" x:Name="SearchPanelBorder"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="540" Margin="0,80,0,0"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-20" To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="-15" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border CornerRadius="14" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.2" Color="#FF000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 搜索输入框 -->
                        <Border Padding="18,0" Height="48" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <Grid>
                                <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}"
                                      Width="16" Height="16" Stretch="Uniform" Opacity="0.4"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                      IsHitTestVisible="False"/>
                                <TextBox x:Name="MainSearchBox"
                                         Style="{StaticResource SearchInput}"
                                         FontSize="15" Padding="28,0,8,0"
                                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchBox_KeyDown"
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"/>
                                <TextBlock x:Name="SearchPlaceholder" FontSize="13"
                                           VerticalAlignment="Center" Margin="28,0,0,0"
                                           Opacity="0.35" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MainSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- 搜索结果滚动区 -->
                        <ScrollViewer x:Name="SearchResultsPanel" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto" MaxHeight="380">
                            <Grid>
                                <!-- 搜索中状态 -->
                                <Border Visibility="{Binding IsSearching, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                        Padding="20,28">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextPrimaryBrush}"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.3"/>
                                        <TextBlock Text="正在搜索..." FontSize="13"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 无结果状态 -->
                                <Border Visibility="{Binding ShowNoResults, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                        Padding="20,28">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextPrimaryBrush}"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.3"/>
                                        <TextBlock Text="未找到相关内容" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock Text="试试其他关键词" FontSize="12"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 初始状态 -->
                                <Border Visibility="{Binding ShowInitial, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                        Padding="20,24">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconKeyboard}" Fill="{DynamicResource TextPrimaryBrush}"
                                              Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.3"/>
                                        <TextBlock Text="输入关键词，实时搜索全部内容" FontSize="13"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <Run Foreground="{DynamicResource TextTertiaryBrush}" Text="自动搜索 · "/>
                                            <Run Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Text="Esc"/>
                                            <Run Foreground="{DynamicResource TextTertiaryBrush}" Text=" 关闭"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 搜索结果列表 -->
                                <ItemsControl ItemsSource="{Binding SearchResults}"
                                              Visibility="{Binding ShowResults, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="14,10" Margin="8,3"
                                                    Cursor="Hand" MouseLeftButtonDown="SearchResult_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="8" Width="38" Height="38">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{DynamicResource Primary}" Opacity="0.1"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Icon}" FontSize="15"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="320"
                                                                       local:Highlight.Text="{Binding Title}"
                                                                       local:Highlight.Keyword="{Binding Keyword}"/>
                                                            <Border CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{DynamicResource Primary}" Opacity="0.08"/>
                                                                </Border.Background>
                                                                <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Medium"
                                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                                   local:Highlight.Text="{Binding Content}"
                                                                   local:Highlight.Keyword="{Binding Keyword}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <!-- 底部提示栏 -->
                        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <Grid>
                                <!-- 结果统计（结果态显示） -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding ShowResults, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SearchSummary}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding SearchTruncated, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                               Text="仅显示前 20 条，缩小关键词查看全部"/>
                                </StackPanel>
                                <!-- 键盘提示（非结果态显示） -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Visibility="{Binding ShowResults, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text="Ctrl+F 打开 · "/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Text="Enter"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text=" 立即搜索 · "/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Text="Esc"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text=" 关闭"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Border>

            <!-- ===== Toast 通知浮层 ===== -->
            <Border Grid.Column="1" Panel.ZIndex="70"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24">
                <ItemsControl ItemsSource="{Binding Source={x:Static svc:ToastService.Instance}, Path=Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ToastCard" CornerRadius="10" Padding="16,12"
                                    Margin="0,0,0,8" MinWidth="280" MaxWidth="380"
                                    IsHitTestVisible="True"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Effect="{StaticResource ShadowMd}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                            VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Success">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource DangerLightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Info">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                        <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource IconInfo}"/>
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Success">
                                                            <Setter Property="Data" Value="{StaticResource IconCheck}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Error">
                                                            <Setter Property="Data" Value="{StaticResource IconCancel}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                            <Setter Property="Data" Value="{StaticResource IconWarning}"/>
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Message}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <Button Visibility="{Binding HasAction, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                                Command="{Binding ActionCommand}"
                                                Style="{StaticResource BtnGhost}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"
                                                Content="{Binding ActionText}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" FontSize="11"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="4" Margin="8,0,0,0" Cursor="Hand"
                                            VerticalAlignment="Top"
                                            Command="{Binding Source={x:Static svc:ToastService.Instance}, Path=DismissCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}"
                                              Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToastCard"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="ToastCard"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="40" To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <DataTrigger Binding="{Binding IsDismissing}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ToastCard"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetName="ToastCard"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="0" To="30" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</Window>
