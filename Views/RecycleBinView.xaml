<UserControl x:Class="EapWorkAssistant.Views.RecycleBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
             FontFamily="{StaticResource DefaultFont}">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:CountToVisibilityConverter x:Key="CountToVis"/>
        <local:SelectionModeConverter x:Key="SelModeConv"/>

        <!-- 回收站类型标签颜色映射 -->
        <Style x:Key="TagWorkRecord" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="TagKnowledge" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style x:Key="TagIssue" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>

        <!-- 筛选 Tab 按钮样式 -->
        <Style x:Key="FilterTab" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 操作按钮（带图标） -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <DockPanel>

            <!-- ==================== 顶部信息栏 ==================== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="24,20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">

                <!-- 标题行：标题 + 统计 + 操作 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：图标 + 标题 + 描述 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- 垃圾桶图标 -->
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource DangerLightBrush}"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconTrash}" Width="18" Height="18"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="回收站" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="误删的内容会先进入这里，可随时恢复或彻底删除"
                                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间：类型筛选 Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Margin="20,0">

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="全部">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTab}">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterType}" Value="全部">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FilterType}" Value="工作记录">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FilterType}" Value="知识库">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FilterType}" Value="问题跟踪">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="全部"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6,1"
                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="工作记录"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTab}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterType}" Value="工作记录">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="3.5"
                                        Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="工作记录"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6,1"
                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding WorkRecordCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="知识库"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTab}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterType}" Value="知识库">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="3.5"
                                        Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="知识库"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6,1"
                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding KnowledgeCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="问题跟踪"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTab}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterType}" Value="问题跟踪">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="3.5"
                                        Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="问题跟踪"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6,1"
                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding IssueCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="请假记录"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTab}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterType}" Value="请假记录">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="3.5"
                                        Background="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="请假记录"/>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6,1"
                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding LeaveRecordCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧：操作按钮组 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- 多选模式切换 -->
                        <ToggleButton IsChecked="{Binding IsMultiSelectMode}" Cursor="Hand"
                                      Style="{StaticResource BtnGhost}" Padding="10,6" ToolTip="多选模式">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSelectAll}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="多选" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- 清空回收站 -->
                        <Button Command="{Binding EmptyCommand}" Style="{StaticResource BtnDanger}"
                                Content="清空回收站" IsEnabled="{Binding HasItems}"
                                Margin="8,0,0,0" Padding="14,7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 批量操作栏（多选模式下显示） ==================== -->
            <Border DockPanel.Dock="Top" Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="14,10"
                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <Run Text="已选 "/>
                        <Run Text="{Binding SelectedItems.Count, Mode=OneWay}"/>
                        <Run Text=" 项"/>
                    </TextBlock>
                    <Separator Style="{StaticResource Divider}" Margin="10,0" VerticalAlignment="Stretch"/>

                    <Button Command="{Binding BatchRestoreCommand}" Style="{StaticResource BtnSuccess}"
                            IsEnabled="{Binding HasSelection}" Padding="12,5" Margin="0,0,6,0"
                            ToolTip="批量恢复到原模块">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRestore}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="恢复选中" FontSize="12" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BatchPermanentDeleteCommand}" Style="{StaticResource BtnDanger}"
                            IsEnabled="{Binding HasSelection}" Padding="12,5" ToolTip="彻底删除选中项">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDeleteForever}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="彻底删除" FontSize="12" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ==================== 主列表区域 ==================== -->
            <Border Style="{StaticResource Card}" Padding="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- DataGrid 列表 -->
                    <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource ModernGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeaderWidth="0" Margin="8"
                              SelectionMode="{Binding IsMultiSelectMode, Converter={StaticResource SelModeConv}, FallbackValue=Single}"
                              local:DataGridHelper.SelectedItemsList="{Binding SelectedItems, Mode=OneWay}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridColumnHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernGridCell}"/>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernGridRow}"/>
                            </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- 类型列：紧凑彩色标签（固定窄宽，仅展示分类标识） -->
                            <DataGridTemplateColumn Header="类型" Width="80"
                                                    ClipboardContentBinding="{Binding TypeLabel}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="8,4" CornerRadius="6" Padding="10,4"
                                                Background="{DynamicResource SurfaceAltBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EntityType}" Value="WorkRecord">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EntityType}" Value="Knowledge">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EntityType}" Value="Issue">
                                                            <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="12" FontWeight="Medium"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="WorkRecord">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Knowledge">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Issue">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 标题列（主标识符，弹性宽度 * 确保不被截断） -->
                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*" MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                        <Setter Property="ToolTip" Value="{Binding Title}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 摘要列（次要信息，固定合理宽度） -->
                            <DataGridTextColumn Header="摘要" Binding="{Binding Detail}" Width="220" MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}">
                                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 删除时间列（固定格式，精确适配） -->
                            <DataGridTextColumn Header="删除时间" Binding="{Binding DeletedAt}" Width="145">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextTrim}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 操作列（两个按钮紧凑排列） -->
                            <DataGridTemplateColumn Header="操作" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">

                                            <!-- 恢复按钮 -->
                                            <Button Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnGhost}" Padding="6,4" FontSize="12"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    Content="恢复"/>

                                            <!-- 彻底删除按钮 -->
                                            <Button Command="{Binding DataContext.PermanentDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnGhost}" Padding="6,4" FontSize="12"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Content="删除" Margin="2,0,0,0"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ==================== 空状态 ==================== -->
                    <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="320">
                            <!-- 空状态插图 -->
                            <Border Width="72" Height="72" CornerRadius="22"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,16"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Path Data="{StaticResource IconRecycleEmpty}" Width="32" Height="32"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Border>

                            <TextBlock Text="回收站是空的" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="删除的内容会出现在这里，可随时恢复或彻底清除"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
