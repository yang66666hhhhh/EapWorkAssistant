<UserControl x:Class="EapWorkAssistant.Views.RecycleBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
             FontFamily="{StaticResource DefaultFont}">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="28,24">
        <DockPanel>
            <!-- 顶部栏 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="24,22"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="回收站" Style="{StaticResource Heading2}"/>
                        <TextBlock Text="误删的内容会先进入这里，可随时恢复或彻底删除"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding EmptyCommand}" Style="{StaticResource BtnDanger}"
                            Content="清空回收站" IsEnabled="{Binding HasItems}"/>
                </Grid>
            </Border>

            <!-- 列表 -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource ModernGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeaderWidth="0" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="类型" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tag}" Margin="8,0">
                                            <TextBlock Text="{Binding TypeLabel}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="200"
                                                ElementStyle="{StaticResource GridTextTrim}"/>
                            <DataGridTextColumn Header="摘要" Binding="{Binding Detail}" Width="*"
                                                ElementStyle="{StaticResource GridTextTrim}"/>
                            <DataGridTemplateColumn Header="操作" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Button Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" Content="恢复"/>
                                            <Button Command="{Binding DataContext.PermanentDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource BtnDanger}" Content="彻底删除" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态 -->
                    <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconClipboard}" Width="44" Height="44" Stretch="Uniform"
                                  Fill="{DynamicResource TextTertiaryBrush}" Opacity="0.5"/>
                            <TextBlock Text="回收站是空的" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="删除的内容会出现在这里，可随时恢复"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
