<UserControl x:Class="EapWorkAssistant.Views.RecycleBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
             xmlns:controls="clr-namespace:EapWorkAssistant.Controls"
             FontFamily="{StaticResource DefaultFont}">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:CountToVisibilityConverter x:Key="CountToVis"/>
        <local:SelectionModeConverter x:Key="SelModeConv"/>

        <!-- 回收站类型标签颜色映射 -->
        <Style x:Key="TagWorkRecord" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="TagKnowledge" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style x:Key="TagIssue" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>

        <!-- 筛选 Tab 按钮基础样式（普通态） -->
        <Style x:Key="FilterTabBase" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 各筛选 Tab 的激活态（FilterType 匹配时高亮） -->
        <Style x:Key="FilterTabAll" TargetType="Button" BasedOn="{StaticResource FilterTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FilterType}" Value="全部">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterTabWorkRecord" TargetType="Button" BasedOn="{StaticResource FilterTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FilterType}" Value="工作记录">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterTabKnowledge" TargetType="Button" BasedOn="{StaticResource FilterTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FilterType}" Value="知识库">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterTabIssue" TargetType="Button" BasedOn="{StaticResource FilterTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FilterType}" Value="问题跟踪">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterTabLeave" TargetType="Button" BasedOn="{StaticResource FilterTabBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FilterType}" Value="请假记录">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28,24">
        <DockPanel>

            <!-- ==================== 顶部信息栏（极简清爽版） ==================== -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="24,16"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第一层：标题 + 数量统计 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="回收站" FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="{StaticResource FontSizeMd}" FontWeight="Normal"
                                   Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="（共 "/>
                            <Run Text="{Binding TotalCount}"/>
                            <Run Text=" 项）"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 第一层：轻量文字操作按钮（无背景框） -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 多选模式切换 -->
                        <ToggleButton IsChecked="{Binding IsMultiSelectMode}"
                                      Style="{StaticResource BtnGhost}" Padding="8,5"
                                      ToolTip="多选模式" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSelectAll}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="多选" FontSize="{StaticResource FontSizeSm}" Margin="5,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <!-- 清空回收站 -->
                        <Button Command="{Binding EmptyCommand}" IsEnabled="{Binding HasItems}"
                                Style="{StaticResource BtnGhost}" Padding="8,5"
                                ToolTip="清空回收站" Cursor="Hand" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="清空回收站" FontSize="{StaticResource FontSizeSm}" Margin="5,0,0,0"
                                           Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 第二层：辅助提示文字 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="误删的内容会先进入这里，可随时恢复或彻底删除"
                               FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TextHintBrush}"
                               VerticalAlignment="Center" Margin="0,10,0,0"/>

                    <!-- 第三层：类型筛选（合并回卡片内） -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,12,0,0">
                        <Path Data="{StaticResource IconFilter}" Fill="{DynamicResource TextTertiaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="全部"
                                Style="{StaticResource FilterTabAll}" Margin="3,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="全部"/>
                                <Border CornerRadius="{DynamicResource RadiusSm}" Padding="5,1"
                                        Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionPanel}">
                                    <TextBlock FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="工作记录"
                                Style="{StaticResource FilterTabWorkRecord}" Margin="3,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" CornerRadius="{DynamicResource RadiusXxs}"
                                        Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="工作记录"/>
                                <Border CornerRadius="{DynamicResource RadiusSm}" Padding="5,1"
                                        Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionPanel}">
                                    <TextBlock FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding WorkRecordCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="知识库"
                                Style="{StaticResource FilterTabKnowledge}" Margin="3,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" CornerRadius="{DynamicResource RadiusXxs}"
                                        Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="知识库"/>
                                <Border CornerRadius="{DynamicResource RadiusSm}" Padding="5,1"
                                        Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionPanel}">
                                    <TextBlock FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding KnowledgeCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="问题跟踪"
                                Style="{StaticResource FilterTabIssue}" Margin="3,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" CornerRadius="{DynamicResource RadiusXxs}"
                                        Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="问题跟踪"/>
                                <Border CornerRadius="{DynamicResource RadiusSm}" Padding="5,1"
                                        Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionPanel}">
                                    <TextBlock FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding IssueCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetFilterCommand}" CommandParameter="请假记录"
                                Style="{StaticResource FilterTabLeave}" Margin="3,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" CornerRadius="{DynamicResource RadiusXxs}"
                                        Background="{DynamicResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="请假记录"/>
                                <Border CornerRadius="{DynamicResource RadiusSm}" Padding="5,1"
                                        Margin="5,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionPanel}">
                                    <TextBlock FontSize="{StaticResource FontSizeXs}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold">
                                        <Run Text="{Binding LeaveRecordCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 批量操作栏（多选模式下显示） ==================== -->
            <Border DockPanel.Dock="Top" Visibility="{Binding IsMultiSelectMode, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource PrimarySoftBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="14,10"
                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <Run Text="已选 "/>
                        <Run Text="{Binding SelectedItems.Count, Mode=OneWay}"/>
                        <Run Text=" 项"/>
                    </TextBlock>
                    <Separator Style="{StaticResource Divider}" Margin="10,0" VerticalAlignment="Stretch"/>

                    <Button Command="{Binding BatchRestoreCommand}" Style="{StaticResource BtnSuccess}"
                            IsEnabled="{Binding HasSelection}" Padding="12,5" Margin="0,0,6,0"
                            ToolTip="批量恢复到原模块">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRestore}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="恢复选中" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BatchPermanentDeleteCommand}" Style="{StaticResource BtnDanger}"
                            IsEnabled="{Binding HasSelection}" Padding="12,5" ToolTip="彻底删除选中项">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDeleteForever}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="彻底删除" FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ==================== 主列表区域 ==================== -->
            <Border Style="{StaticResource Card}" Padding="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <!-- DataGrid 列表 -->
                    <controls:DataGridBase ItemsSource="{Binding Items}" TableKey="RecycleBin"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeaderWidth="0" Margin="8"
                              CanUserResizeColumns="True"
                              SelectionMode="{Binding IsMultiSelectMode, Converter={StaticResource SelModeConv}, FallbackValue=Single}"
                              local:DataGridHelper.SelectedItemsList="{Binding SelectedItems, Mode=OneWay}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernGridColumnHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernGridCell}"/>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernGridRow}"/>
                            </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- 类型列：紧凑彩色标签（Auto 适配内容，避免截断） -->
                            <DataGridTemplateColumn Header="类型" Width="110" MinWidth="90"
                                                    ClipboardContentBinding="{Binding TypeLabel}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" Margin="8,4" CornerRadius="{DynamicResource RadiusXs}" Padding="10,4"
                                                >
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EntityType}" Value="WorkRecord">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EntityType}" Value="Knowledge">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EntityType}" Value="Issue">
                                                            <Setter Property="Background" Value="{DynamicResource WarningLightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="{StaticResource FontSizeSm}" FontWeight="Medium"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="WorkRecord">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Knowledge">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EntityType}" Value="Issue">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 标题 + 摘要列（上下堆叠形成主次关系，弹性宽度） -->
                            <DataGridTemplateColumn Header="标题 / 摘要" Width="360" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{StaticResource CellPad}" VerticalAlignment="Center">
                                            <!-- 主：标题（加粗） -->
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeMd}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                            <!-- 次：摘要（变灰） -->
                                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="{StaticResource GapTopXxs}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Detail}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 删除时间列（固定格式，精准适配，不截断） -->
                            <DataGridTextColumn Header="删除时间" Binding="{Binding DeletedAtText}" Width="160" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="None"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding DeletedAtText}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 操作列（两个按钮，间隔 8px） -->
                            <DataGridTemplateColumn Header="操作" Width="140" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">

                                            <!-- 恢复按钮 -->
                                            <Button Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnGhost}" Padding="6,4" FontSize="{StaticResource FontSizeSm}"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    Content="恢复"/>

                                            <!-- 彻底删除按钮 -->
                                            <Button Command="{Binding DataContext.PermanentDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnGhost}" Padding="6,4" FontSize="{StaticResource FontSizeSm}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconTrashCan}" Width="13" Height="13" Stretch="Uniform"
                                                          Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="删除"/>
                                                </StackPanel>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </controls:DataGridBase>

                    <!-- ==================== 空状态 ==================== -->
                    <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <controls:EmptyState IconPathData="{StaticResource IconRecycleEmpty}"
                                             Title="回收站是空的"
                                             Description="删除的内容会出现在这里，可随时恢复或彻底清除"/>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
