<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==================== 颜色体系（Refined Precision） ==================== -->
    <Color x:Key="Primary">#FF4338CA</Color>
    <Color x:Key="PrimaryHover">#FF3630AE</Color>
    <Color x:Key="PrimaryLight">#FFE9EEFF</Color>
    <Color x:Key="PrimarySoft">#FFF3F5FF</Color>
    <Color x:Key="Secondary">#FF6B7280</Color>
    <Color x:Key="Success">#FF059669</Color>
    <Color x:Key="SuccessLight">#FFECFDF5</Color>
    <Color x:Key="Warning">#FFD97706</Color>
    <Color x:Key="WarningLight">#FFFEF3C7</Color>
    <Color x:Key="Danger">#FFDC2626</Color>
    <Color x:Key="DangerLight">#FFFEF2F2</Color>
    <Color x:Key="Surface">#FFF4F6FB</Color>
    <Color x:Key="SurfaceHover">#FFECF0F8</Color>
    <Color x:Key="SurfaceAlt">#FFF8FAFD</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="TextPrimary">#FF0F172A</Color>
    <Color x:Key="TextSecondary">#FF475569</Color>
    <Color x:Key="TextTertiary">#FF94A3B8</Color>
    <Color x:Key="Border">#FFE2E8F0</Color>
    <Color x:Key="BorderHover">#FFC7D2E4</Color>
    <Color x:Key="SidebarBg">#FF0B1120</Color>
    <Color x:Key="SidebarText">#FF94A3B8</Color>
    <Color x:Key="SidebarHover">#FF162033</Color>
    <Color x:Key="SidebarCardBg">#FF1E293B</Color>
    <Color x:Key="ScrollThumb">#FFCBD5E1</Color>
    <Color x:Key="ScrollThumbHover">#FF94A3B8</Color>
    <Color x:Key="ScrollThumbActive">#FF64748B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHover}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLight}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{DynamicResource PrimarySoft}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource Secondary}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource Success}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{DynamicResource SuccessLight}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource Warning}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{DynamicResource WarningLight}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource Danger}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{DynamicResource DangerLight}"/>
    <!-- 信息蓝（日历周末加班蓝点） -->
    <SolidColorBrush x:Key="InfoBrush" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#FFDBEAFE"/>
    <!-- 假期类型圆点颜色 -->
    <SolidColorBrush x:Key="LeaveAnnualBrush" Color="#FF06B6D4"/>   <!-- 年假：青色 -->
    <SolidColorBrush x:Key="LeavePersonalBrush" Color="#FFF59E0B"/> <!-- 事假：琥珀 -->
    <SolidColorBrush x:Key="LeaveSickBrush" Color="#FF10B981"/>     <!-- 病假：翠绿 -->
    <SolidColorBrush x:Key="LeaveCompBrush" Color="#FFA78BFA"/>     <!-- 调休：紫罗兰 -->
    <SolidColorBrush x:Key="LeaveTravelBrush" Color="#FF3B82F6"/>   <!-- 出差：蓝色 -->
    <SolidColorBrush x:Key="LeaveMarriageBrush" Color="#FFEC4899"/> <!-- 婚假：粉色 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHover}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAlt}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiary}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource Border}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{DynamicResource BorderHover}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{DynamicResource SidebarBg}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{DynamicResource SidebarText}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{DynamicResource SidebarHover}"/>
    <SolidColorBrush x:Key="SidebarCardBgBrush" Color="{DynamicResource SidebarCardBg}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumb}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ScrollThumbHover}"/>
    <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="{DynamicResource ScrollThumbActive}"/>
    <!-- 弹窗背景遮罩（双主题，由 ThemeService 按主题设置：浅色 #4D000000≈0.30 / 暗色 #99000000≈0.60） -->
    <SolidColorBrush x:Key="OverlayMaskBrush" Color="#4D000000"/>
    <SolidColorBrush x:Key="AvatarOverlayBrush" Color="#50000000"/>
    <SolidColorBrush x:Key="AvatarHeavyOverlayBrush" Color="#60000000"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#CCFFFFFF"/>

    <!-- 渐变画笔 -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4338CA" Offset="0"/>
        <GradientStop Color="#FF7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF4338CA" Offset="0"/>
        <GradientStop Color="#FF7C3AED" Offset="0.5"/>
        <GradientStop Color="#FF4338CA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBannerGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF6366F1" Offset="0"/>
        <GradientStop Color="#FF4F46E5" Offset="0.5"/>
        <GradientStop Color="#FFA5B4FC" Offset="1"/>
    </LinearGradientBrush>

    <!-- 强调色 -->
    <Color x:Key="AccentIndigo">#FF4338CA</Color>
    <Color x:Key="AccentViolet">#FF7C3AED</Color>
    <SolidColorBrush x:Key="AccentIndigoBrush" Color="{DynamicResource AccentIndigo}"/>
    <SolidColorBrush x:Key="AccentVioletBrush" Color="{DynamicResource AccentViolet}"/>

    <!-- ==================== 字体 ==================== -->
    <FontFamily x:Key="DefaultFont">Microsoft YaHei UI, Segoe UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>

    <!-- 字体大小（可被 ThemeService 动态修改） -->
    <sys:Double x:Key="BaseFontSize">13</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>
    <sys:Double x:Key="Heading3FontSize">16</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">11</sys:Double>

    <!-- 全局 UI 缩放因子（字体大小联动） -->
    <sys:Double x:Key="UIScale">1.0</sys:Double>

    <!-- 界面密度间距（ThemeService 动态修改，Thickness 类型） -->
    <Thickness x:Key="DensityCardPad">24</Thickness>
    <Thickness x:Key="DensityRowPad">20,14</Thickness>
    <Thickness x:Key="DensityRowPadSm">18,11</Thickness>
    <Thickness x:Key="DensityListPad">14,12</Thickness>
    <Thickness x:Key="DensitySectionMargin">0,0,0,18</Thickness>
    <Thickness x:Key="DensityRowMargin">0,0,0,6</Thickness>
    <Thickness x:Key="DensityItemMargin">0,0,0,12</Thickness>

    <!-- ==================== 圆角 token ==================== -->
    <!-- 统一圆角档位，供样式与 View 引用，消除散落的魔法数字（AGENTS.md 要求） -->
    <CornerRadius x:Key="RadiusXs">6</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">22</CornerRadius>
    <CornerRadius x:Key="RadiusPill">9999</CornerRadius>
    <!-- 圆角补充令牌：主刻度之外的次要半径，统一就近归入主令牌，避免业务页硬编码 -->
    <CornerRadius x:Key="RadiusHair">1</CornerRadius>
    <CornerRadius x:Key="RadiusXxs">4</CornerRadius>
    <CornerRadius x:Key="RadiusLeftSm">8,0,0,8</CornerRadius>
    <CornerRadius x:Key="RadiusLeftMd">11,0,0,11</CornerRadius>
    <CornerRadius x:Key="RadiusLeftLg">13,0,0,13</CornerRadius>
    <!-- 卡片左侧色带专用，与 RadiusCard 完全对齐，避免视觉上“未贴合” -->
    <CornerRadius x:Key="RadiusLeftCard">16,0,0,16</CornerRadius>

    <!-- ==================== 阴影效果（更精致） ==================== -->
    <DropShadowEffect x:Key="ShadowSm" BlurRadius="16" ShadowDepth="1" Opacity="0.045" Color="#FF000000"/>
    <DropShadowEffect x:Key="ShadowMd" BlurRadius="28" ShadowDepth="4" Opacity="0.075" Color="#FF000000"/>
    <DropShadowEffect x:Key="ShadowLg" BlurRadius="44" ShadowDepth="8" Opacity="0.11" Color="#FF000000"/>
    <DropShadowEffect x:Key="ShadowFocus" BlurRadius="14" ShadowDepth="0" Opacity="0.16" Color="#FF6366F1"/>

    <!-- ==================== 模态框阴影（双主题，环境光 + 主光双层） ==================== -->
    <!-- 主色固定 #2466FF；Opacity 由 ThemeService 按主题设置（浅色 0.18 / 暗色 0.06） -->
    <Color x:Key="ModalShadowColor">#FF2466FF</Color>
    <!-- 主光：聚焦投影，BlurRadius 40 / ShadowDepth 20 -->
    <DropShadowEffect x:Key="ModalShadow" BlurRadius="40" ShadowDepth="20"
                      Color="{DynamicResource ModalShadowColor}" Opacity="0.18"/>
    <!-- 环境光：柔和扩散光晕，BlurRadius 60 / ShadowDepth 0（Opacity 由 ThemeService 设置：浅色 0.10 / 暗色 0.04） -->
    <DropShadowEffect x:Key="ModalShadowAmbient" BlurRadius="60" ShadowDepth="0"
                      Color="{DynamicResource ModalShadowColor}" Opacity="0.10"/>
    <!-- 模态窗口重阴影（独立 Window 如 ProfileDialog，浮在深色遮罩之上）
         需要极强的立体感——高对比度黑色投影 + 较大深度，让卡片像从暗背景中"破土而出"
         Opacity 由 ThemeService 按主题设置（浅色 0.40 / 暗色 0.25） -->
    <DropShadowEffect x:Key="ModalHeavyShadow" BlurRadius="50" ShadowDepth="24"
                      Color="#FF000000" Opacity="0.40"/>

    <!-- ==================== 动效时长（Storyboard / Trigger 动画统一引用，禁止散落字面量 Duration） ==================== -->
    <!-- 注意：必须用 WPF 原生 Duration 类型（不能用 sys:String），否则 Timeline.Duration 属性赋值时类型不匹配报 ArgumentException -->
    <Duration x:Key="DurationFast">0:0:0.15</Duration>
    <Duration x:Key="DurationNormal">0:0:0.25</Duration>
    <Duration x:Key="DurationSlow">0:0:0.40</Duration>
    <!-- 入场专用：页面转场 / 窗口加载（略快于 DurationNormal，避免"慢半拍"的拖沓感） -->
    <Duration x:Key="DurationEnter">0:0:0.22</Duration>
    <!-- 侧边栏折叠展开（原 MainWindow.xaml.cs 硬编码 220ms） -->
    <Duration x:Key="DurationSidebar">0:0:0.22</Duration>

    <!-- ==================== 缓动函数 ==================== -->
    <!-- 全项目统一缓动：快出慢收（EaseOut），无回弹、无过冲，符合"克制专业"定位
         注意：Storyboard 内禁止 DynamicResource，此处用 StaticResource 引用即可 -->
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut"/>

    <!-- ==================== 动效位移量（px） ==================== -->
    <!-- 页面入场位移：略大于卡片上浮量，形成"从下方浮入"的层次感 -->
    <sys:Double x:Key="MotionPageEnterY">12</sys:Double>
    <!-- 窗口首次加载位移 -->
    <sys:Double x:Key="MotionWindowEnterY">10</sys:Double>
    <!-- 卡片悬停上浮量（与 Styles.xaml 的 CardHover / CardElevated 保持一致） -->
    <sys:Double x:Key="MotionHoverLiftY">2</sys:Double>
    <!-- CornerClip 向外扩张量：UIElement.Clip 会连同 Effect（投影）一起裁掉，
         故裁剪矩形须外扩 ≥ 投影最大扩散范围（ShadowMd: BlurRadius 28 / ShadowDepth 4 → 约 18px），
         同时圆角半径同步增大，保证子元素视觉圆角不变 -->
    <sys:Double x:Key="ClipShadowPad">20</sys:Double>

    <!-- ==================== 页面外边距（统一各 View 根布局留白） ==================== -->
    <Thickness x:Key="PageMargin">28,24,28,24</Thickness>

    <!-- ==================== 动画 ==================== -->
    <Storyboard x:Key="FadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource DurationNormal}"/>
    </Storyboard>
    <!-- ==================== 字号刻度（可被 ThemeService 动态修改） ==================== -->
    <sys:Double x:Key="FontSizeXxs">10</sys:Double>
    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">12</sys:Double>
    <sys:Double x:Key="FontSizeMd">13</sys:Double>
    <sys:Double x:Key="FontSizeLg">15</sys:Double>
    <sys:Double x:Key="FontSizeXl">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>

    <!-- ==================== 间距刻度（Thickness，禁止页面硬编码 Margin/Padding 数值） ==================== -->
    <Thickness x:Key="SpaceXxs">2</Thickness>
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">12</Thickness>
    <Thickness x:Key="SpaceLg">16</Thickness>
    <Thickness x:Key="SpaceXl">24</Thickness>
    <Thickness x:Key="CellPad">10,6</Thickness>
    <Thickness x:Key="GapTopXxs">0,3,0,0</Thickness>

    <!-- 次要标题（空状态主标题等） -->
    <sys:Double x:Key="FontSizeSubtitle">17</sys:Double>

    <!-- 辅助提示灰（保留回收站提示 #999999 语义；禁止页面硬编码色值，统一引用此令牌） -->
    <Color x:Key="TextHint">#FF999999</Color>
    <SolidColorBrush x:Key="TextHintBrush" Color="{DynamicResource TextHint}"/>

    <!-- 空状态插图方框尺寸（图标容器，引用令牌避免硬编码） -->
    <sys:Double x:Key="IllustrationSize">72</sys:Double>

    <!-- 状态小圆点尺寸（类型筛选 Tab 前的彩色圆点） -->
    <sys:Double x:Key="StatusDotSize">6</sys:Double>

    <!-- ==================== 补全令牌（用户迁移补齐） ==================== -->
    <!-- 字号补充（标题层级 / 正文 / 说明 / 微标） -->
    <sys:Double x:Key="FontSizeMicro">10</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSection">16</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>
    <!-- 介于正文与层级之间的强调字号，以及分页控件的半步字号 -->
    <sys:Double x:Key="FontSizeLead">14</sys:Double>
    <sys:Double x:Key="FontSizeBodySm">12.5</sys:Double>

    <!-- 圆角补充（侧滑面板左圆角、浮层面板圆角） -->
    <CornerRadius x:Key="RadiusSidePanel">18,0,0,18</CornerRadius>
    <CornerRadius x:Key="RadiusPopup">14</CornerRadius>

    <!-- 颜色补充（阴影基色、日历遮罩、按钮白字） -->
    <Color x:Key="ShadowBaseColor">#FF000000</Color>
    <SolidColorBrush x:Key="CalendarOverlayBrush" Color="#180B1120"/>
    <SolidColorBrush x:Key="OnPrimaryTextBrush" Color="#FFFFFFFF"/>

    <!-- 控件尺寸令牌（避免按钮/输入/分页等固定宽高散落魔法数字） -->
    <sys:Double x:Key="IconButtonSize">34</sys:Double>
    <sys:Double x:Key="ControlMinHeight">40</sys:Double>
    <sys:Double x:Key="ControlMinHeightSm">36</sys:Double>
    <sys:Double x:Key="InputHeight">42</sys:Double>
    <sys:Double x:Key="SwitchTrackWidth">44</sys:Double>
    <sys:Double x:Key="SwitchTrackHeight">24</sys:Double>
    <sys:Double x:Key="SwitchThumbSize">20</sys:Double>
    <sys:Double x:Key="PagerSize">32</sys:Double>
    <sys:Double x:Key="ToolTipMaxWidth">400</sys:Double>

</ResourceDictionary>
