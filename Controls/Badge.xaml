<UserControl x:Class="EapWorkAssistant.Controls.Badge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Controls"
             x:Name="Self">
    <Border Style="{StaticResource Tag}"
            Background="{Binding BackgroundBrush, ElementName=Self}"
            HorizontalAlignment="Left">
        <TextBlock Text="{Binding Text, ElementName=Self}"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{Binding ForegroundBrush, ElementName=Self}"/>
    </Border>
</UserControl>
