<UserControl x:Class="EapWorkAssistant.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Controls"
             xmlns:helpers="clr-namespace:EapWorkAssistant.Helpers"
             x:Name="Self">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Padding="8,0" Height="34" VerticalAlignment="Center">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索图标 -->
            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}"
                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.5"/>

            <!-- 输入框 -->
            <TextBox x:Name="InputBox" Grid.Column="1"
                     Text="{Binding Text, ElementName=Self, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchInput}" BorderThickness="0" Background="Transparent"
                     Padding="0" VerticalAlignment="Center" FontSize="12.5"/>

            <!-- 水印占位符：文本为空/null 时显示 -->
            <TextBlock Grid.Column="1" Text="{Binding Placeholder, ElementName=Self}"
                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12.5"
                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Self}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=Self}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 一键清除：文本非空时显示 -->
            <Button x:Name="ClearButton" Grid.Column="2" Click="ClearButton_Click"
                    Width="18" Height="18" Margin="6,0,0,0" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    ToolTip="清空"
                    Visibility="{Binding Text, ElementName=Self, Converter={x:Static helpers:StringToVisibilityConverter.Instance}}">
                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}"
                      Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
