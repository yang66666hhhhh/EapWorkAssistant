<UserControl x:Class="EapWorkAssistant.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
             x:Name="Self"
             FontFamily="{StaticResource DefaultFont}">
    <Border x:Name="CardBorder"
            Style="{Binding CardStyle, ElementName=Self}"
            Padding="0"
            ClipToBounds="True"
            local:CornerClip.Enable="True"
            Cursor="{Binding Cursor, ElementName=Self}"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding BarWidth, ElementName=Self}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧彩色色带：由外层圆角裁剪贴合卡片圆角 -->
            <Border Grid.Column="0" Background="{Binding BarBrush, ElementName=Self}" CornerRadius="{DynamicResource RadiusLeftCard}"/>

            <!-- 内容区 -->
            <Grid Grid.Column="1" Margin="{Binding InnerPadding, ElementName=Self}">
                <StackPanel>
                    <TextBlock Text="{Binding Title, ElementName=Self}" FontWeight="Medium">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                                        <Setter Property="FontSize" Value="10.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                                        <Setter Property="Margin" Value="0,2,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Value, ElementName=Self}" FontWeight="Bold"
                                   Foreground="{Binding BarBrush, ElementName=Self}"
                                   Typography.NumeralAlignment="Tabular">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="FontSize" Value="28"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                                            <Setter Property="FontSize" Value="22"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Unit, ElementName=Self}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Bottom">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Margin" Value="3,0,0,6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Margin" Value="2,0,0,4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding SubText, ElementName=Self}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"
                               Visibility="{Binding SubText, ElementName=Self, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/>

                <!-- 趋势胶囊：涨红跌绿（中国习惯），TrendText 为空时隐藏 -->
                <Grid HorizontalAlignment="Left" Margin="0,7,0,0"
                      Visibility="{Binding TrendText, ElementName=Self, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                    <Border Background="{Binding TrendUp, ElementName=Self, Converter={x:Static local:TrendBrushConverter.Instance}}"
                            Opacity="0.12" CornerRadius="{DynamicResource RadiusPill}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,3">
                        <Path Width="9" Height="9" Stretch="Uniform"
                              Fill="{Binding TrendUp, ElementName=Self, Converter={x:Static local:TrendBrushConverter.Instance}}"
                              VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M12,4 L4,12 H9 V20 H15 V12 H20 L12,4 Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrendUp, ElementName=Self}" Value="False">
                                            <Setter Property="Data" Value="M12,20 L4,12 H9 V4 H15 V12 H20 L12,20 Z"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding TrendText, ElementName=Self}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding TrendUp, ElementName=Self, Converter={x:Static local:TrendBrushConverter.Instance}}"
                                   Margin=" 4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
            <Border Background="{Binding IconBackgroundBrush, ElementName=Self}" CornerRadius="{DynamicResource RadiusMd}"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="44"/>
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                                <Setter Property="Width" Value="36"/>
                                <Setter Property="Height" Value="36"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IconPathData, ElementName=Self}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Path Data="{Binding IconPathData, ElementName=Self}" Fill="{Binding IconForegroundBrush, ElementName=Self}"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Width" Value="20"/>
                            <Setter Property="Height" Value="20"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                                    <Setter Property="Width" Value="16"/>
                                    <Setter Property="Height" Value="16"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
