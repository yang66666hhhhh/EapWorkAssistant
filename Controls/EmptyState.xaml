<UserControl x:Class="EapWorkAssistant.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Helpers"
             x:Name="Self"
             FontFamily="{StaticResource DefaultFont}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Margin" Value="32"/>
                <Setter Property="MaxWidth" Value="360"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                        <Setter Property="Margin" Value="12"/>
                        <Setter Property="MaxWidth" Value="260"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>

        <!-- 插画容器：默认 IllustrationSize，紧凑态缩小到 32px -->
        <!-- 装饰层（P2 ⑪）：底部淡圆环 + 右上小圆点，增加插画层次；紧凑态隐藏保持克制 -->
        <!-- ⚠️ 可见性不能走 StringToVisibilityConverter（IconPathData 是 Geometry，as string 恒 null → 永远 Collapsed），
             改用 DataTrigger 判 {x:Null}（修复既有 bug：此前插画从未显示过） -->
        <Border Background="{DynamicResource PrimarySoftBrush}"
                HorizontalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="{DynamicResource IllustrationSize}"/>
                    <Setter Property="Height" Value="{DynamicResource IllustrationSize}"/>
                    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IconPathData, ElementName=Self}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- 装饰：外扩淡圆环（溢出容器形成光环，紧凑态隐藏） -->
                <Ellipse Width="94" Height="94" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                         Opacity="0.12" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsCompact, ElementName=Self, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>
                <!-- 装饰：右上小圆点 -->
                <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" Opacity="0.3"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                         Visibility="{Binding IsCompact, ElementName=Self, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>

                <Path Data="{Binding IconPathData, ElementName=Self}"
                      Fill="{DynamicResource PrimaryBrush}"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Width" Value="34"/>
                            <Setter Property="Height" Value="34"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                                    <Setter Property="Width" Value="18"/>
                                    <Setter Property="Height" Value="18"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Border>

        <TextBlock Text="{Binding Title, ElementName=Self}"
                   HorizontalAlignment="Center" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="Margin" Value="0,18,0,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            <Setter Property="Margin" Value="0,8,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="{Binding Description, ElementName=Self}"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   Visibility="{Binding Description, ElementName=Self, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                    <Setter Property="Margin" Value="0,8,0,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Self}" Value="True">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Margin" Value="0,4,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Button Content="{Binding ActionContent, ElementName=Self}"
                Command="{Binding ActionCommand, ElementName=Self}"
                Style="{StaticResource BtnPrimary}"
                Margin="0,18,0,0"
                Visibility="{Binding ActionContent, ElementName=Self, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/>
    </StackPanel>
</UserControl>
