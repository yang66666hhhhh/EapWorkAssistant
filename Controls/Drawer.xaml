<UserControl x:Class="EapWorkAssistant.Controls.Drawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EapWorkAssistant.Controls"
             x:Name="Self">
    <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- 遮罩层（点击关闭） -->
        <Border x:Name="Backdrop" Style="{StaticResource OverlayBackdrop}"
                Visibility="Collapsed" MouseLeftButtonDown="Backdrop_Click"/>

        <!-- 右侧滑入面板 -->
        <Border x:Name="SidePanel" Style="{StaticResource SidePanel}"
                Width="{Binding DrawerWidth, ElementName=Self}"
                HorizontalAlignment="Right" Visibility="Collapsed"
                PreviewKeyDown="SidePanel_PreviewKeyDown">
            <DockPanel LastChildFill="True">
                <!-- 默认头部（HeaderContent 为空时显示：图标 + 标题 + 副标题 + 关闭按钮） -->
                <StackPanel x:Name="DefaultHeader" DockPanel.Dock="Top" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource PrimaryLightBrush}"
                                    CornerRadius="{DynamicResource RadiusSm}" Width="32" Height="32" Margin="0,0,12,0">
                                <Path Data="{Binding HeaderIcon, ElementName=Self}" Fill="{DynamicResource PrimaryBrush}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeaderTitle, ElementName=Self}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding HeaderSubtitle, ElementName=Self}" FontSize="11.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding CloseCommand, ElementName=Self}" Style="{StaticResource BtnGhost}" Padding="8,6">
                            <Button.ToolTip>
                                <ToolTip Content="关闭面板 (Esc)"/>
                            </Button.ToolTip>
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextTertiaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,0" Opacity="0.5"/>
                </StackPanel>

                <!-- 自定义头部（HeaderContent 非空时显示，覆盖默认头部） -->
                <ContentPresenter x:Name="HeaderPresenter" DockPanel.Dock="Top"
                                  Content="{Binding HeaderContent, ElementName=Self}" Visibility="Collapsed"/>

                <!-- 底部操作栏（由 View 提供） -->
                <ContentPresenter x:Name="FooterPresenter" DockPanel.Dock="Bottom"
                                  Content="{Binding FooterContent, ElementName=Self}"/>

                <!-- 表单主体（中间填充，由 View 提供） -->
                <ContentPresenter x:Name="BodyPresenter" Content="{Binding Body, ElementName=Self}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
